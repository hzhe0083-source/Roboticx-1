  <diagram id="va-wm-training-component" name="VA-WM Training">
    <mxGraphModel dx="1300" dy="580" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="580" math="0" shadow="0">
