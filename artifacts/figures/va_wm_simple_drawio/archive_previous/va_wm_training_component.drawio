        <mxCell id="wm_target" value="&lt;b&gt;Independent WM batch · next DINO Z*&lt;/b&gt;&lt;br&gt;target stop-grad" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#B7E9FB;strokeColor=#262626;strokeWidth=2;fontFamily=Helvetica;fontSize=15;fontColor=#262626;" vertex="1" parent="1">
