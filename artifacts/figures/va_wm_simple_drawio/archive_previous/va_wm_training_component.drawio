        <mxCell id="title" value="&lt;b&gt;VA / WM training&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#262626;align=center;" vertex="1" parent="1">
