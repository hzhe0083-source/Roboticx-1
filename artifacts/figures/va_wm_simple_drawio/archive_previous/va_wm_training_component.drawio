        <mxCell id="e_target_va" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#262626;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="va_target" target="va_loss"><mxGeometry relative="1" as="geometry" /></mxCell>
