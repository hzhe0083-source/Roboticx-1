        <mxCell id="e_va_optimizer" value="L&lt;sub&gt;VA&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#E66B19;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=0;entryY=0.5;fontFamily=Helvetica;fontSize=13;fontColor=#E66B19;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="va_loss" target="optimizer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_wm_optimizer" value="L&lt;sub&gt;WM&lt;/sub&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeColor=#4D78B8;strokeWidth=2.5;exitX=0.5;exitY=1;entryX=1;entryY=0.5;fontFamily=Helvetica;fontSize=13;fontColor=#4D78B8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wm_loss" target="optimizer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_gradient_boundary" value="VA-batch forward: sg(Z) → K&lt;sup&gt;W&lt;/sup&gt;,V&lt;sup&gt;W&lt;/sup&gt; · no L&lt;sub&gt;VA&lt;/sub&gt; → predictor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=classic;endFill=1;strokeColor=#4D78B8;strokeWidth=2;exitX=0;exitY=0.5;entryX=1;entryY=0.5;fontFamily=Helvetica;fontSize=13;fontColor=#4D78B8;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="wm_loss" target="va_loss"><mxGeometry relative="1" as="geometry" /></mxCell>
