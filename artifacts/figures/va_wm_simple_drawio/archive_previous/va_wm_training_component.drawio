          <mxGeometry x="470" y="440" width="410" height="85" as="geometry" />
        </mxCell>
        <mxCell id="joint_note" value="L&lt;sub&gt;WM&lt;/sub&gt; also shapes the VA snapshot features read by WM" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#646464;align=center;" vertex="1" parent="1">
