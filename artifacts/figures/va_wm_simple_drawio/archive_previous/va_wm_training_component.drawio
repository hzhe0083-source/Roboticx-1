        <mxCell id="va_loss" value="&lt;b&gt;VA · Flow matching&lt;/b&gt;&lt;br&gt;x&lt;sub&gt;τ&lt;/sub&gt;=(1−τ)ε+τa* ; u*=a*−ε&lt;br&gt;L&lt;sub&gt;VA&lt;/sub&gt;=MaskedMSE(v&lt;sub&gt;θ&lt;/sub&gt;(x&lt;sub&gt;τ&lt;/sub&gt;,τ),u*)&lt;br&gt;&lt;font color=&quot;#646464&quot;&gt;prefix / tail weighted&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE2B2;strokeColor=#262626;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="90" y="205" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="wm_loss" value="&lt;b&gt;WM predictor / L&lt;sub&gt;WM&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;WM batch: L&lt;sub&gt;i&lt;/sub&gt;=.25L&lt;sub&gt;all&lt;/sub&gt;+.25L&lt;sub&gt;motion&lt;/sub&gt;+.50L&lt;sub&gt;top20&lt;/sub&gt;+L&lt;sub&gt;NR(all)&lt;/sub&gt;&lt;br&gt;L&lt;sub&gt;WM&lt;/sub&gt;=Avg&lt;sub&gt;w&lt;/sub&gt;(L&lt;sub&gt;i&lt;/sub&gt;)+4L&lt;sub&gt;static&lt;/sub&gt;+L&lt;sub&gt;rank&lt;/sub&gt;+L&lt;sub&gt;readout&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#B7E9FB;strokeColor=#262626;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="840" y="205" width="420" height="145" as="geometry" />
        </mxCell>
        <mxCell id="belief_training" value="&lt;b&gt;B&lt;sub&gt;i&lt;/sub&gt;, ν&lt;sub&gt;i&lt;/sub&gt;: no direct target&lt;/b&gt;&lt;br&gt;trained through L&lt;sub&gt;WM&lt;/sub&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F4B9;strokeColor=#262626;strokeWidth=2;fontFamily=Helvetica;fontSize=14;fontColor=#262626;" vertex="1" parent="1">
          <mxGeometry x="545" y="85" width="260" height="55" as="geometry" />
