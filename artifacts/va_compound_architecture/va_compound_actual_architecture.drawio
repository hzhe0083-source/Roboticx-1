        <mxCell id="query_streams" value="&lt;b&gt;查询流 Query streams&lt;/b&gt;&lt;br&gt;Visual V&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;i−1&lt;/sup&gt; [B,N&lt;sub&gt;v&lt;/sub&gt;,512]&lt;br&gt;Action A&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;i−1&lt;/sup&gt; [B,H,512]" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="context_streams" value="&lt;b&gt;上下文流 Key / value&lt;/b&gt;&lt;br&gt;current V · previous M&lt;sup&gt;i&lt;/sup&gt; · Action A&lt;br&gt;cached Language K&lt;sub&gt;L&lt;/sub&gt;&lt;sup&gt;i&lt;/sup&gt;,U&lt;sub&gt;L&lt;/sub&gt;&lt;sup&gt;i&lt;/sup&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="690" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="query_projection" value="&lt;b&gt;LayerNorm → q&lt;sub&gt;v&lt;/sub&gt; / q&lt;sub&gt;a&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;Q = [V W&lt;sub&gt;Q&lt;/sub&gt;&lt;sup&gt;V&lt;/sup&gt; ; A W&lt;sub&gt;Q&lt;/sub&gt;&lt;sup&gt;A&lt;/sup&gt;]&lt;br&gt;reshape → 8 heads" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="kv_projection" value="&lt;b&gt;LayerNorm → role-specific K / U&lt;/b&gt;&lt;br&gt;k,u for V · M · A&lt;br&gt;+ cached K&lt;sub&gt;L&lt;/sub&gt;,U&lt;sub&gt;L&lt;/sub&gt; → concat" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="360" y="690" width="240" height="95" as="geometry" />
        </mxCell>
        <mxCell id="attention" value="&lt;b&gt;共享 Scaled Dot-Product Attention&lt;/b&gt;&lt;br&gt;scores(fp32) = QK&lt;sup&gt;T&lt;/sup&gt; / √64&lt;br&gt;softmax(scores) U 同时更新 V 与 A" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2.5;fontFamily=Helvetica;fontSize=14;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="760" y="615" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="role_mask" value="&lt;b&gt;role_mask + language_mask&lt;/b&gt;　bidir_va：V/A 读全部 K/U　｜　uni_a：Visual Q 仅读 Visual K" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontFamily=Helvetica;fontSize=11;fontColor=#92400E;" vertex="1" parent="1">
          <mxGeometry x="630" y="755" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="split_updates" value="&lt;b&gt;Split + output projections&lt;/b&gt;&lt;br&gt;update → ΔV, ΔA&lt;br&gt;out_v / out_a" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1080" y="615" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="residual_ffn" value="&lt;b&gt;Residual + 独立 pre-norm FFN&lt;/b&gt;&lt;br&gt;V ← V + out_v + ffn_v&lt;br&gt;A ← A + out_a + ffn_a" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1370" y="615" width="210" height="105" as="geometry" />
        </mxCell>
        <mxCell id="layer_memory" value="&lt;b&gt;同层记忆写回&lt;/b&gt;&lt;br&gt;M&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;i&lt;/sup&gt; = V&lt;sub&gt;t&lt;/sub&gt;&lt;sup&gt;i&lt;/sup&gt;&lt;br&gt;历史长度不增长" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1660" y="560" width="200" height="85" as="geometry" />
        </mxCell>
        <mxCell id="layer_next" value="&lt;b&gt;层间 / 输出传递&lt;/b&gt;&lt;br&gt;V&lt;sup&gt;i&lt;/sup&gt;, A&lt;sup&gt;i&lt;/sup&gt; → Layer i+1&lt;br&gt;最后一层 A → Action Head" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1660" y="710" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="edge_query_projection" value="V / A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#334155;fontFamily=Helvetica;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="query_streams" target="query_projection"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_context_projection" value="V / M / A / L" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#D97706;fontFamily=Helvetica;fontSize=10;fontColor=#92400E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="context_streams" target="kv_projection"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_q_attention" value="Q" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=11;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.3;" edge="1" parent="1" source="query_projection" target="attention"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_kv_attention" value="K, U" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=11;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.76;" edge="1" parent="1" source="kv_projection" target="attention"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_mask_attention" value="mask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#D97706;fontFamily=Helvetica;fontSize=10;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="role_mask" target="attention"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_attention_split" value="update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="attention" target="split_updates"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_split_residual" value="ΔV / ΔA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=10;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="split_updates" target="residual_ffn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_res_memory" value="V&lt;sup&gt;i&lt;/sup&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#D97706;fontFamily=Helvetica;fontSize=10;fontColor=#92400E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;entryX=0;entryY=0.5;" edge="1" parent="1" source="residual_ffn" target="layer_memory"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_res_next" value="V&lt;sup&gt;i&lt;/sup&gt;, A&lt;sup&gt;i&lt;/sup&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#16A34A;fontFamily=Helvetica;fontSize=10;fontColor=#15803D;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.72;entryX=0;entryY=0.5;" edge="1" parent="1" source="residual_ffn" target="layer_next"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="training_header" value="&lt;b&gt;C · 当前训练入口（train.py：预计算特征上的 VA 复合体训练）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;align=left;spacingLeft=14;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="40" y="825" width="1820" height="36" as="geometry" />
        </mxCell>
        <mxCell id="training_features" value="&lt;b&gt;features.pt / synthetic_sequence&lt;/b&gt;&lt;br&gt;vision [N,T,N&lt;sub&gt;v&lt;/sub&gt;,768] · language [N,N&lt;sub&gt;l&lt;/sub&gt;,2048]&lt;br&gt;proprio · previous action · expert action chunks" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="60" y="885" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="paired_sampler" value="&lt;b&gt;FeatureDataset + PairedBatchSampler&lt;/b&gt;&lt;br&gt;每个 pair 恰好 2 行 · 共享 t=0 状态&lt;br&gt;不同 instruction_id / 专家动作" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="410" y="885" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="temporal_rollout" value="&lt;b&gt;rollout_policy&lt;/b&gt;&lt;br&gt;语言 K/V 只构建一次&lt;br&gt;T≥4 顺序展开 · M&lt;sub&gt;t−1&lt;/sub&gt; → M&lt;sub&gt;t&lt;/sub&gt;&lt;br&gt;跨时刻反向传播" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="690" y="885" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="training_losses" value="&lt;b&gt;总损失&lt;/b&gt;&lt;br&gt;Huber behavior cloning&lt;br&gt;+ λ&lt;sub&gt;pair&lt;/sub&gt; · Huber(t=0 预测动作差, 专家动作差)&lt;br&gt;共享决策状态迫使语言解释动作差异" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1020" y="885" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="optimizer" value="&lt;b&gt;AdamW&lt;/b&gt;&lt;br&gt;gradient clip = 1.0&lt;br&gt;更新 VA Compound" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1420" y="885" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;可选 checkpoint&lt;/b&gt;&lt;br&gt;config + model state&lt;br&gt;+ training contract" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontFamily=Helvetica;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1660" y="885" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="training_note" value="&lt;b&gt;重要边界：train.py --data&lt;/b&gt; 直接读取预计算的 vision_tokens / language_hidden；Qwen 与 V-JEPA 保持冻结，不参与端到端骨干微调。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="995" width="1080" height="42" as="geometry" />
        </mxCell>
        <mxCell id="source_note" value="来源：README.md · docs/VA_COMPOUND_REPORT.md · backbones.py · model.py · train.py" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="1160" y="995" width="700" height="42" as="geometry" />
        </mxCell>

        <mxCell id="edge_features_sampler" value="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=1.8;strokeColor=#334155;fontFamily=Helvetica;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="training_features" target="paired_sampler"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_sampler_rollout" value="pair" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=1.8;strokeColor=#334155;fontFamily=Helvetica;fontSize=11;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="paired_sampler" target="temporal_rollout"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_rollout_losses" value="pred" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontFamily=Helvetica;fontSize=11;fontColor=#6D28D9;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="temporal_rollout" target="training_losses"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_losses_optimizer" value="grad" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#DC2626;fontFamily=Helvetica;fontSize=11;fontColor=#B91C1C;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="training_losses" target="optimizer"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="edge_optimizer_checkpoint" value="save" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;endFill=1;strokeWidth=2;strokeColor=#16A34A;fontFamily=Helvetica;fontSize=11;fontColor=#15803D;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="optimizer" target="checkpoint"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
