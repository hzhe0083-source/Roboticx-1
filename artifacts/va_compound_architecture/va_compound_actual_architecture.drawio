        <mxCell id="layer_header" value="&lt;b&gt;B · 单个 VACouplingLayer 的真实计算（第 i 层）&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#64748B;strokeWidth=1.5;align=left;spacingLeft=14;fontFamily=Helvetica;fontSize=16;fontColor=#0F172A;" vertex="1" parent="1">
