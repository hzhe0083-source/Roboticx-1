        <mxCell id="secC" value="C · 通讯风险与最小实验（从左到右按优先级；以下是 hypotheses，不是已确认 bug）" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=16;fontStyle=1;align=left;spacingLeft=14;fontFamily=Helvetica;" vertex="1" parent="1">
