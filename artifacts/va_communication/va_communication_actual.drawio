        </mxCell>
        <mxCell id="vaLayers" value="VA layers ×4&lt;br&gt;&lt;b&gt;latent A tokens&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;read V / M / A / L&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;strokeWidth=1.8;fontColor=#4C1D95;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="410" y="640" width="235" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="condition" value="C&lt;sub&gt;t&lt;/sub&gt; = LN(A&lt;sup&gt;4&lt;/sup&gt;)&lt;br&gt;&lt;b&gt;[B, 8, 512]&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;computed once / observation&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#2563EB;strokeWidth=2.2;fontColor=#4C1D95;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="715" y="640" width="235" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="flowHead" value="&lt;b&gt;FlowMatchingHead&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;t&lt;/sub&gt; + projection(a&lt;sup&gt;τ&lt;/sup&gt;) + time(τ)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;TransformerEncoder ×2 → velocity&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.8;fontColor=#0F172A;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1020" y="640" width="350" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="solver" value="Euler ×8 &lt;font style=&quot;font-size:10px&quot;&gt;(default)&lt;/font&gt;&lt;br&gt;&lt;b&gt;reuse fixed C&lt;sub&gt;t&lt;/sub&gt;&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.8;fontColor=#334155;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1435" y="640" width="170" height="105" as="geometry"/>
        </mxCell>
