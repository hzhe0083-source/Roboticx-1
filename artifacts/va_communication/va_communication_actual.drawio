        <mxCell id="initA" value="learned queries [H=8, 512]&lt;br&gt;&lt;b&gt;+ state_projection&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;(proprio, previous_action)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;strokeWidth=1.8;fontColor=#4C1D95;fontSize=13;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1">
