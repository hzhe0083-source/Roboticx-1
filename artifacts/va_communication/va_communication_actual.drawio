        <mxCell id="risk1" value="&lt;b&gt;P0 · A→V 是否真被用到&lt;/b&gt;&lt;br&gt;代码有路径，不等于模型会利用。&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;固定 V/M/L，仅扰动 A，测 ΔV；再做 A→V mask ablation。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="85" y="895" width="326" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="risk2" value="&lt;b&gt;P1 · 一层延迟&lt;/b&gt;&lt;br&gt;Layer 1 的 A→V 主要是 query + robot state。&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;实验：逐层扰动 A，比较 ΔV / Δaction。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="441" y="895" width="326" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="risk3" value="&lt;b&gt;P1 · latent / physical gap&lt;/b&gt;&lt;br&gt;VA 内的 A 不是候选动作 a&lt;sup&gt;τ&lt;/sup&gt;。&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;实验：将 a&lt;sup&gt;τ&lt;/sup&gt; 投影后注入 VA 做消融。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="797" y="895" width="326" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="risk4" value="&lt;b&gt;P2 · 无 solver feedback&lt;/b&gt;&lt;br&gt;采样中 C&lt;sub&gt;t&lt;/sub&gt; 固定，候选轨迹不重新查询 VA/Vision。&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;实验：fixed C&lt;sub&gt;t&lt;/sub&gt; vs 周期性 re-encode。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1153" y="895" width="326" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="risk5" value="&lt;b&gt;P2 · token competition&lt;/b&gt;&lt;br&gt;共享 softmax 中 A=8，V/M/L token 更多。&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;实验：按来源记录 attention mass / entropy，并检查 A→V 梯度。&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#7C2D12;fontSize=14;align=left;verticalAlign=top;spacingTop=10;spacingLeft=12;spacingRight=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="1509" y="895" width="321" height="128" as="geometry"/>
        </mxCell>

        <mxCell id="footer" value="Source: va_compound/model.py, README.md, tests/test_model.py　｜　现有测试覆盖 L→V、M→V 与 memory→action；尚无直接 A-intervention→V sensitivity 测试。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#64748B;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="1770" height="22" as="geometry"/>
